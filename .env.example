# HerHealth Production & Development Environment Configuration
# Copy this file to .env and provide your project credentials.

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Application Settings
VITE_APP_NAME=HerHealth
VITE_APP_URL=http://localhost:5173

# Educational Health Assistant (Proxied/Protected)
VITE_AI_ASSISTANT_ENABLED=true
# Medical education mode: 'curated_library' | 'llm_service'
VITE_HEALTH_ASSISTANT_MODE=curated_library
